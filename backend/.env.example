DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: "gemini" (bepul/arzon, standart) yoki "claude" (zaxira)
AI_PROVIDER=gemini
# Model nomi (ixtiyoriy) - bo'sh qoldirsangiz har provayder o'zining arzon standart modelini ishlatadi
AI_MODEL=

# API kalitlar (faqat backend'da saqlanadi)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Generatsiya endpointlari uchun oddiy chegara
AI_RATE_LIMIT=20/hour

# Email (parolni tiklash). Bo'sh qoldirilsa xatlar konsolga chiqadi.
FRONTEND_URL=http://localhost:5173
